{
  "name": "mako-react-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/mako-wasm --target web --out-dir ../../packages/mako-browser/pkg --release",
    "policy": "node scripts/copy-policy.mjs",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run wasm && npm run policy && npm run typecheck && vite build",
    "dev": "npm run wasm && npm run policy && vite",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "mako-browser": "file:../../packages/mako-browser",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
